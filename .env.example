# ==============================================================================
# A.E.R.O.S. - Automated Emergency Response & Optimization Network
# Environment Configuration
# ==============================================================================

# Active camera source mode: 'esp32' (live IP stream) or 'sample' (sample_crash.mp4)
CAMERA_SOURCE=esp32

# ESP32-CAM live stream endpoint URL
# Default IP on local WiFi network: 10.143.81.138 on port 81 (/stream)
# If your ESP32-CAM receives a new DHCP address from your router, update this URL.
# Operational Recommendation: Configure a DHCP IP reservation on your router for stability.
ESP32_STREAM_URL=http://10.143.81.138:81/stream

# Fallback behavior if ESP32-CAM is unreachable:
# 'none'   - Reports disconnected state and attempts bounded reconnection (default)
# 'sample' - Automatically switches to sample_crash.mp4 footage
CAMERA_FALLBACK=none

# Bounded retry backoff interval in seconds for stream reconnection
CAMERA_RECONNECT_INTERVAL=2.0

# Decoupled YOLOv8 inference rate in frames per second (e.g. 5.0 to 10.0 FPS)
# Keeps camera capture at native stream rate while bounding CPU utilization.
INFERENCE_FPS=8.0

